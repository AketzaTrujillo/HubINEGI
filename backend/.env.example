# Copia este archivo como .env y pon tu contraseña de MySQL
MYSQL_PASSWORD=tu_contraseña_aqui

# Modelo de Ollama (por defecto qwen2.5:7b)
# OLLAMA_MODEL=qwen2.5:7b

# Proveedor de LLM: local (Ollama) u opencode
# MHUB_LLM_PROVIDER=local
# Respaldo automático si el proveedor falla (opcional): local | opencode
# MHUB_LLM_FALLBACK=

# Agente (Fase 10): auto | 1 | 0  (auto = activo con opencode)
# MHUB_AGENTE=auto

# OpenCode Go (solo si MHUB_LLM_PROVIDER=opencode)
# OPENCODE_API_KEY=tu-api-key-aqui
# OPENCODE_GO_MODEL=deepseek-v4.1-flash
# OPENCODE_URL=https://opencode.ai/zen/go/v1/chat/completions

# Opcionales (por defecto: localhost / 3306 / root / HUBDATOS)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=HUBDATOS
