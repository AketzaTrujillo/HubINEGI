# Copia este archivo como .env y pon tu contraseña de MySQL
MYSQL_PASSWORD=tu_contraseña_aqui

# Modelo de Ollama (por defecto qwen2.5:7b)
# OLLAMA_MODEL=qwen2.5:7b

# Proveedor de LLM: local (Ollama) u opencode
# MHUB_LLM_PROVIDER=local
# Respaldo automático si el proveedor falla (opcional): local | opencode
# MHUB_LLM_FALLBACK=

# Agente (Fase 10): auto | 1 | 0  (auto = activo con opencode)
# MHUB_AGENTE=auto

# OpenCode Go (solo si MHUB_LLM_PROVIDER=opencode)
# OPENCODE_API_KEY=tu-api-key-aqui
# OPENCODE_GO_MODEL=deepseek-v4.1-flash
# OPENCODE_URL=https://opencode.ai/zen/go/v1/chat/completions

# Opcionales (por defecto: localhost / 3306 / root / HUBDATOS)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=HUBDATOS

# Recuperación del corpus documental (Fase 3)
# fulltext = MATCH ... AGAINST (comportamiento oficial)
# embedding = similitud vectorial
# hybrid = Reciprocal Rank Fusion de ambos
MHUB_CORPUS_MODE=fulltext
MHUB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MHUB_EMBEDDING_BATCH=32
MHUB_CORPUS_TOP_K=3
MHUB_HYBRID_K=60

# Versión de recuperación: v1 (original, por defecto) | v2 (mejorada)
MHUB_CORPUS_VERSION=v1

# --- v2 ---
# hybrid = BM25 + embeddings + RRF (rápido)
# hybrid_rerank = agrega cross-encoder (más lento)
MHUB_V2_MODE=hybrid
MHUB_V2_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MHUB_V2_EMBEDDING_BATCH=32
MHUB_V2_CHUNK_TOKENS=350
MHUB_V2_CHUNK_OVERLAP=50
MHUB_V2_CANDIDATOS=40
MHUB_RRF_LEX=2.0
MHUB_RRF_SEM=1.0
MHUB_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MHUB_RERANK_TOP_N=10
MHUB_RERANK_BATCH=16
# MHUB_RERANKER=0
# MHUB_PRECARGAR=1
# MHUB_PRECARGAR_RERANKER=0
